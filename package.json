  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.27.0",
    "vite": "8.3.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
