# Local Flask runtime. Set your own admin password; never commit .env.
APP_ENV=development
DEMO_MODE=true
PRINT_MODE=simulation
PORT=5000
COOKIE_SECURE=false
SECRET_KEY=
ADMIN_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Required only when running the separate print agent.
PRINT_AGENT_TOKEN=
PRINT_WORKSPACE=
PRINT_AGENT_PRINTER_ID=pi-01
AGENT_API_URL=http://127.0.0.1:5000
AGENT_MODE=simulation
CUPS_PRINTER_NAME=
# Explicit opt-in for a controlled hardware demo. False by default.
ALLOW_TEST_PRINTING=false
# Future live payment integration point; currently disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
